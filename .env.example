# PostgreSQL 管理账号仅用于容器初始化，不提供给应用。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-admin-password
POSTGRES_DB=ai_interview

# 运行账号只能执行必要的 DML，迁移账号负责 Alembic 与 schema DDL。
# 密码若包含 URL 保留字符，请先进行百分号编码再用于连接串。
APP_RUNTIME_PASSWORD=replace-with-runtime-password
APP_MIGRATION_PASSWORD=replace-with-migration-password

# 生产 Compose 中数据库主机名为 postgres；两个 URL 不得互换。
DATABASE_URL=postgresql://app_runtime:replace-with-runtime-password@postgres:5432/ai_interview
MIGRATION_DATABASE_URL=postgresql://app_migration:replace-with-migration-password@postgres:5432/ai_interview

# Backend
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=development
CORS_ORIGINS=https://interview.careray.com,https://interview.photonthix.com
APP_DOMAINS=interview.careray.com, interview.photonthix.com
UNIFIED_ENTRY_HOSTS=
TRUSTED_PROXY_CIDRS=172.16.0.0/12
RATE_LIMIT_PUBLIC_CODE_SUBMIT=10
RATE_LIMIT_PUBLIC_ESSAY_SUBMIT=5
RATE_LIMIT_MAX_BUCKETS=10000

# Initial administrator created on first startup.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-initial-admin-password
INITIAL_ADMIN_NAME=System Admin

# LLM defaults. You can also configure these in the System Settings page.
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.5-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 应用层单进程分钟级限流；生产还必须在受信网关/WAF 配置集中限流。
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC_UPLOAD=10
RATE_LIMIT_PUBLIC_CODE_RUN=30

# Frontend
VITE_API_URL=/api
